# 统一换行，避免 Windows 工作树把 CRLF 带进 Linux/musl 构建与脚本执行
* text=auto eol=lf

# 明确要求 LF 的类型
*.sh      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.lua     text eol=lf
*.htm     text eol=lf
*.mk      text eol=lf
Makefile  text eol=lf
*.json    text eol=lf
*.py      text eol=lf

# 二进制/生成物
*.ipk     binary
*.tar.zst binary
