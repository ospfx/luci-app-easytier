#!/bin/sh /etc/rc.common
# Copyright (C) 2008-2020 OpenWrt.org
#
# 极薄委托脚本：这里不承载任何业务逻辑，start/stop/reload/status 各转发一条
# 命令给 /usr/sbin/easytierd。原来由 procd 承担的进程监督（respawn 3600/5/20、
# 日志轮转、信号级联 kill）现在由 easytierd 自己实现，所以不再注册 procd 实例。
#
# 保留 USE_PROCD=1 与 START=99 只是为了不改变 OpenWrt 侧的启动排序与
# /etc/rc.d/S99easytier 的既有约定。

START=99
USE_PROCD=1
EXTRA_COMMANDS="status"

PROG=/usr/sbin/easytierd

start() { "$PROG" service start; }
stop() { "$PROG" service stop; }
reload() { "$PROG" service reload; }
status() { "$PROG" service status; }

# USE_PROCD=1 时 rc.common 可能经 start_service 进入启动流程，
# 给它同一个入口（直接调 easytierd，不回调本脚本的 start，避免任何递归）。
start_service() { "$PROG" service start; }
