{
  "luci-app-easytier": {
    "description": "Grant UCI access for luci-app-easytier",
    "read": {
      "uci": [ "easytier" ],
      "file": {
        "/usr/bin/easytier-cli": [ "exec" ]
      },
      "cgi-io": [ "upload" ]
    },
    "write": {
      "uci": [ "easytier" ],
      "file": {
        "/usr/bin/easytier-cli": [ "exec" ]
      }
    }
  }
}
